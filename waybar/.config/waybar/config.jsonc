{
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 0,
  "modules-left": [
    "hyprland/workspaces",
    "tray"
  ],
  "modules-center": ["hyprland/window"],
  "modules-right": [
    "group/stats",
    "group/power-drawer",
    "custom/notification"
  ],
 
  "hyprland/workspaces": {
	"format": "{name}: {icon}",
	"format-icons": {
		"1": "",
		"2": "",
		"3": "",
		"4": "",
		"5": "",
		"6": "",
		"7": "",
		"8": "",
		"9": "",
		"active": "",
		"default": ""
	},
	"exclude-urgent": true,  // Optional: Exclude urgent workspaces
	"persistent": false      // Disable persistent workspaces if your setup supports this option
  },

  "group/stats": {
    "orientation": "horizontal",
    "modules": [
      "network",
      "custom/vpn",
      "battery",
      "bluetooth",
      "pulseaudio",
      "backlight",
      "custom/temperature",
      "disk",
      "memory",
      "cpu",
      "clock"
    ]
  },
  "group/power-drawer": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 300,
      "transition-left-to-right": false
    },
    "modules": ["custom/power", "custom/reboot", "custom/lock"]
  },
  "custom/lock": {
  "format": "<span color='#00FFFF'>  </span>",
  "on-click": "hyprlock",
  "tooltip": true,
  "tooltip-format": "Lock"
  },
  "custom/reboot": {
    "format": "<span color='#FFD700'>  </span>",
    "on-click": "systemctl reboot",
    "tooltip": true,
    "tooltip-format": "Reboot"
  },
  "custom/power": {
    "format": "<span color='#FF4040'>  </span><span color='#555555'> ‹</span>",
    "on-click": "systemctl poweroff",
    "tooltip": true,
    "tooltip-format": "Shutdown"
  },
  "network": {
    "format-wifi": "<span  color='#00FFFF'>{icon}</span>",
    "format-ethernet": "<span  color='#7FFF00'> </span>Wired ",
    "tooltip-format": "<span  color='#FF1493'> 󰅧  </span>{bandwidthUpBytes} <span color='#00BFFF'> 󰅢  </span>{bandwidthDownBytes}",
    "format-linked": "<span  color='#FFA500'>󱘖</span>{ifname} (No IP) ",
    "format-disconnected": "<span  color='#FF4040'></span>",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "interval": 5,
    "on-click": "kitty nmtui"
  },
  "custom/vpn": {
    "format": "{}",
    "exec": "~/.config/waybar/scripts/toggle_vpn.sh",
    "interval": 2,
    "return-type": "json",
    "on-click": "~/.config/waybar/scripts/toggle_vpn.sh --toggle"
},
"battery": {
  "states": {
    "warning": 30,
    "critical": 15
  },
  "format-charging": "<span  color='#28CD41'>󱐋</span>",
  "format-plugged": "<span  color='#28CD41'>󱐋</span>",
  "format-full": "<span  color='#28CD41'>󱐋</span>",
  "format": "<span  color='#28CD41'>{icon}</span>",
  "interval": 1,
  "format-icons": ["󰂎", "󰁼", "󰁿", "󰂁", "󰁹"],  

  "tooltip": true,
},

  "pulseaudio": {
    "format": "<span color='#00FF7F'>{icon}</span>  {volume}%",
    "format-muted": "<span  color='#FF4040'>󰖁</span>0% ",
    "format-icons": {
      "headphone": "<span  color='#BF00FF'></span>",
      "hands-free": "<span  color='#BF00FF'></span>",
      "headset": "<span  color='#BF00FF'></span>",
      "phone": "<span  color='#00FFFF'></span>",
      "portable": "<span  color='#00FFFF'></span>",
      "car": "<span  color='#FFA500'></span>",
      "default": [
        "<span color='#808080'></span>",
        "<span color='#FFFF66'></span>",
        "<span color='#00FF7F'></span>"
      ]
    },
    "on-click-right": "pavucontrol -t 3",
    "on-click": "pavucontrol",
    "tooltip": true,
    "tooltip-format": "Volume: {volume}%"
  },
  "custom/temperature": {
    "exec": "sensors | awk '/^Package id 0:/ {print int($4)}'",
    "format": "<span  color='#FFA500'> </span>{}°C",
    "interval": 5,
    "tooltip": true,
    "tooltip-format": "CPU Temperature: {}°C"
  },
  "memory": {
    "format": "<span  color='#8A2BE2'>    </span>{used:0.1f}G/{total:0.1f}G",
    "tooltip": true,
    "tooltip-format": "RAM: {used:0.2f}G/{total:0.2f}G"
  },
  "disk": {
    "path": "/",
    "interval": 30,
    "format": "<span color='#00CED1'> </span>{percentage_used}%",
    "states": {
      "warning": 80,
      "critical": 90
    },
    "tooltip": true,
    "tooltip-format": "SSD  {used} / {total}  ·  {free} free  ·  {percentage_used}%"
  },
  "cpu": {
    "format": "<span  color='#FF9F0A'> </span>{usage}%",
    "tooltip": true
  },
  "clock": {
    "interval": 1,
    "timezone": "Africa/Johannesburg",
    "format": "<span  color='#BF00FF'>   </span>{:%H:%M}",
    "tooltip": true,
    "tooltip-format": "{:%A, %d %B %Y}"

  },
  "tray": {
    "icon-size": 17,
    "spacing": 6,
    "show-passive-items": true
  },
  "backlight": {
    "device": "intel_backlight",
    "format": "<span  color='#FFD700'>{icon} </span>{percent}%",
    "tooltip": true,
    "tooltip-format": "Brightness: {percent}%",
    "format-icons": [
      "<span color='#696969'>󰃞</span>", 
      "<span color='#A9A9A9'>󰃝</span>",
      "<span color='#FFFF66'>󰃟</span>",
      "<span color='#FFD700'>󰃠</span>"
    ],
  },
  "custom/notification": {
    "tooltip": false,
    "format": "<span color='#00FFFF'>{icon}</span>",
    "format-icons": {
      "notification": "󰂚",
      "none": "󰂜",
      "dnd-notification": "󰂛",
      "dnd-none": "󰂛"
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },
  "bluetooth": {
  "format-on": "<span  color='#00BFFF'>󰂯</span>",
  "format-off": "<span  color='#00BFFF'>󰂲</span>",
  "format-disabled": "",
  "format-connected": "<span  color='#00BFFF'>󰂱</span>",
  "format-connected-battery": "<span  color='#00BFFF'>󰂱</span>",
  "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
  "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
  "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
  "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%",
  "on-click": "kitty bluetui"
}
}
